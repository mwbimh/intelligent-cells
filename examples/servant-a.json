{
  "id": "servant-a",
  "host": "127.0.0.1",
  "port": 7311,
  "agent": "pi-mock",
  "peers": [
    {
      "id": "servant-b",
      "host": "127.0.0.1",
      "port": 7312
    }
  ],
  "security": {
    "cert": "./identities/servant-a.pem",
    "key": "./identities/servant-a.key",
    "ca": "./identities/ca.pem",
    "trustedPeers": {
      "servant-b": "REPLACE_WITH_VERIFIED_64_HEX_CERTIFICATE_SHA256",
      "master": "REPLACE_WITH_VERIFIED_64_HEX_CERTIFICATE_SHA256"
    },
    "allowExternal": false
  },
  "policy": {
    "maxConcurrent": 4,
    "maxTaskRecords": 4096,
    "grants": {
      "master": {
        "tools": [
          "echo",
          "wait",
          "readFile"
        ],
        "workspace": "./workspace",
        "maxTimeoutMs": 2000,
        "maxConcurrent": 1
      }
    }
  }
}
