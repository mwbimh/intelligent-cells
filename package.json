{
  "name": "intelligent-cells",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "description": "Experimental permission-controlled remote execution cells with mTLS, durable tasks and a real Pi SDK using a deterministic mock model",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "test": "node --test --test-concurrency=1 test/*.test.mjs",
    "demo": "node scripts/demo.mjs",
    "start": "node src/main.mjs --config examples/master.json",
    "test:pi": "node --test --test-concurrency=1 test/pi-*.test.mjs",
    "demo:pi": "node integration/pi/demo.mjs",
    "harden:pi-lock": "node integration/pi/harden-lockfile.mjs",
    "demo:dev": "node integration/pi/demo-development.mjs",
    "test:v03": "node --test --test-concurrency=1 test/*v03*.test.mjs test/pi-resources.test.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.99.2",
    "typebox": "1.3.27"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mwbimh/intelligent-cells.git"
  },
  "homepage": "https://github.com/mwbimh/intelligent-cells#readme",
  "bugs": {
    "url": "https://github.com/mwbimh/intelligent-cells/issues"
  },
  "license": "SEE LICENSE IN LICENSE"
}
